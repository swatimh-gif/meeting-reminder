# MeetFlow Environment Configuration
# ==============================================================================

# 1. Database Configuration (PostgreSQL via psycopg)
# --------------------------------------------------
# Connect to PostgreSQL via individual variables or a single DATABASE_URL
DB_NAME=meetflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Or provide a single PostgreSQL Connection URL (e.g., Neon Cloud PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:password@ep-lucky-sky-a1gx4wcr.ap-southeast-1.aws.neon.tech/meetflow_db?sslmode=require

# 2. WhatsApp Integration (Twilio API for WhatsApp / Meta Cloud API)
# --------------------------------------------------
# If left blank, MeetFlow automatically marks WhatsApp dispatch status as "NOT_CONFIGURED"
# without crashing or faking delivery.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 3. Gmail Integration (SMTP / App Password)
# --------------------------------------------------
# If left blank, MeetFlow automatically marks Gmail dispatch status as "NOT_CONFIGURED"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_gmail_app_password
DEFAULT_FROM_EMAIL=MeetFlow <your_email@gmail.com>

# 4. Application Base URL (for generating WhatsApp and Gmail Authorization Links)
# --------------------------------------------------
APP_BASE_URL=http://127.0.0.1:8000
